# ────────────────────────────────────────────────
# 박스라벨 AI 검사 시스템 — 백엔드 환경변수
# 이 파일을 복사하여 .env 로 저장 후 값을 채워주세요
# ────────────────────────────────────────────────

# [필수] Google Vision API 키
# https://console.cloud.google.com/ → API 및 서비스 → 사용자 인증 정보
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here

# [필수] 클라우디아크 공유링크 (기준값 엑셀 파일 직접 다운로드 URL)
# 엑셀 컬럼 형식: A=검사항목, B=기준값, C=비고 (1행: 헤더)
STANDARDS_EXCEL_URL=https://your-cloudiarck-share-link/file.xlsx

# 기준값 캐시 유효시간 (초, 기본: 3600 = 1시간)
STANDARDS_CACHE_TTL=3600

# ────────────────────────────────────────────────
# 카카오 알림톡 (불량 확정 시 파트장 자동 알림)
# NHN Cloud (https://console.nhncloud.com) 기준
# ────────────────────────────────────────────────

# NHN Cloud 앱키 또는 공급사 API 키
KAKAO_API_KEY=your_kakao_api_key

# 공급사 알림톡 API 엔드포인트
# NHN Cloud 예시: https://api-alimtalk.cloud.toast.com/alimtalk/v2.0/appkeys/{appkey}/messages
KAKAO_API_URL=https://api-alimtalk.cloud.toast.com/alimtalk/v2.0/appkeys/YOUR_APPKEY/messages

# 카카오 플러스친구 발신 프로필 키
KAKAO_SENDER_KEY=your_sender_key

# 등록된 알림톡 템플릿 코드
KAKAO_TEMPLATE_CODE=LABEL_DEFECT_ALERT

# 파트장 수신 전화번호 (하이픈 없이)
KAKAO_RECEIVER_PHONE=01012345678

# ────────────────────────────────────────────────
# CORS 설정 (프론트엔드 URL, 쉼표 구분)
# ────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
